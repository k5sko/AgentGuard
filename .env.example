# Copy to .env and fill in. Never commit the real .env.

# ---- LLM (AI Studio API key from hackathon account) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ---- GitHub App (skip for CLI demo) ----
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# Multiline PEM: paste between quotes, keep the newlines
GITHUB_APP_PRIVATE_KEY=

# ---- Mode ----
# local: webhook runs triage inline as background task (laptop + smee.io)
# cloud: webhook enqueues on Cloud Tasks, separate worker service runs it
AGENTGUARD_MODE=local

# ---- Cloud-mode only ----
GCP_PROJECT=
GCP_LOCATION=us-central1
TASKS_QUEUE=agentguard-repro
WORKER_URL=
WORKER_INVOKER_SA=

# ---- Limits ----
REPRO_TIMEOUT_SECONDS=180
CLONE_TIMEOUT_SECONDS=120
